{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "maxDuration": 800
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api|assets|icon-|pdf.worker.min.js|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
